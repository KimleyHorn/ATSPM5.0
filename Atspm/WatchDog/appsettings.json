  "WatchdogConfiguration": {
    "AmStartHour": 1,
    "AmEndHour": 5,
    "PmPeakStartHour": 16,
    "PmPeakEndHour": 19,
    "WeekdayOnly": false,
    "ConsecutiveCount": 3,
    "MinPhaseTerminations": 50,
    "PercentThreshold": 0.9,
    "MinimumRecords": 500,
    "LowHitThreshold": 50,
    "MaximumPedestrianEvents": 25,
    "EmailAllErrors": true,
    "EmailPmErrors": true,
    "EmailAmErrors": true,
    "EmailRampErrors": false,
    "DefaultEmailAddress": "tcappe@friscotexas.gov",
    "FromEmailAddress": "SPMWatchdog@friscotexas.gov",
    "Sort": "Error"
  },
  "EmailConfiguration": {
    "SmtpEmailService": {
      "Host": "smtp.friscotexas.gov",
      "Port": 25,
      "UserName": "",
      "Password": "",
      "UseUnencryptedSmtp": true,
      "EnableSsl": false
    }
  }
}
